; Engine configuration file. Pinned engine: Godot 4.7.2-stable.

config_version=5

[application]

config/name="Tiny Street: Sort & Restore"
config/description="Sort deliveries, complete orders, and restore a neighborhood café."
config/version="0.2.0"
run/main_scene="res://src/app/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.984, 0.957, 0.91, 1)
boot_splash/show_image=false
config/icon="res://assets/icon/icon.png"
run/low_processor_mode=true

[autoload]

App="*res://src/app/app.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[debug]

gdscript/warnings/inference_on_variant=1

[editor_plugins]

enabled=PackedStringArray("res://addons/tinystreet_monetization/plugin.cfg")

[gui]

common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=30

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=3
environment/defaults/default_clear_color=Color(0.984, 0.957, 0.91, 1)
