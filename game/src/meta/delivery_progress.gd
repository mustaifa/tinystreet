class_name DeliveryProgress
extends RefCounted
## Delivery Logic progression over the save dictionary, namespaced under
## data.logic (separate from the retired sorting campaign in data.campaign).
##
##   logic.cleared[id]  = true                    first clear recorded
##   logic.best[id]     = {pushes, steps}         personal best (fewest pushes, then steps)
##   logic.medals[id]   = {fewest, unassisted}    records only, never pay
##   logic.current      = {id, session}           the attempt in progress
##
## The completion reward is paid once per level through the Wallet ledger
## (key "dl:clear:<id>"), so replays, undo, reopening a result or a restart
## of the app can never pay it twice.

const LEVELS_PATH := "res://data/delivery/levels.json"

var levels: Array = []      # raw dicts in play order
var chapters: Array = []    # [{title, first}]
var _defs := {}

func load_levels(path: String = LEVELS_PATH) -> void:
	levels = []
	chapters = []
	_defs.clear()
	if not FileAccess.file_exists(path):
		return
	var d = JSON.parse_string(FileAccess.get_file_as_string(path))
	if typeof(d) != TYPE_DICTIONARY:
		return
	levels = d.get("levels", []) if d.get("levels") is Array else []
	chapters = d.get("chapters", []) if d.get("chapters") is Array else []
	# Proved minimum pushes, generated by tools/delivery_report.gd --write.
	var pf := path.get_base_dir().path_join("proofs.json")
	var proofs = JSON.parse_string(FileAccess.get_file_as_string(pf)) if FileAccess.file_exists(pf) else null
	if typeof(proofs) == TYPE_DICTIONARY and proofs.get("levels") is Dictionary:
		for l in levels:
			var p = proofs.levels.get(str(l.id))
			if p is Dictionary:
				l["min_pushes"] = int(p.get("min_pushes", -1))

func count() -> int:
	return levels.size()

func level(id: String) -> DeliveryLevel:
	if _defs.has(id):
		return _defs[id]
	for l in levels:
		if str(l.id) == id:
			_defs[id] = DeliveryLevel.from_dict(l)
			return _defs[id]
	return null

func index_of(id: String) -> int:
	for i in levels.size():
		if str(levels[i].id) == id:
			return i
	return -1

func id_at(i: int) -> String:
	return str(levels[i].id) if i >= 0 and i < levels.size() else ""

static func is_cleared(data: Dictionary, id: String) -> bool:
	return bool(data.logic.cleared.get(id, false))

## Playable if first, already cleared, or its predecessor is cleared. A QA
## build (export feature "qa") opens everything; player builds never do.
func is_unlocked(data: Dictionary, i: int) -> bool:
	if i < 0 or i >= levels.size():
		return false
	if BuildConfig.qa_unlock_all():
		return true
	return i == 0 or is_cleared(data, id_at(i)) or is_cleared(data, id_at(i - 1))

func next_index(data: Dictionary) -> int:
	for i in levels.size():
		if not is_cleared(data, id_at(i)):
			return i
	return levels.size() - 1

func cleared_count(data: Dictionary) -> int:
	var n := 0
	for l in levels:
		if is_cleared(data, str(l.id)):
			n += 1
	return n

func all_cleared(data: Dictionary) -> bool:
	return levels.size() > 0 and cleared_count(data) >= levels.size()

func chapter_index(i: int) -> int:
	var best := -1
	for ci in chapters.size():
		var first := index_of(str(chapters[ci].first))
		if first >= 0 and first <= i:
			best = ci
	return best

func chapter_range(ci: int) -> Vector2i:
	var a := index_of(str(chapters[ci].first))
	var b := levels.size() if ci + 1 >= chapters.size() else index_of(str(chapters[ci + 1].first))
	return Vector2i(a, b)

static func best(data: Dictionary, id: String) -> Dictionary:
	var b = data.logic.best.get(id)
	return b if b is Dictionary else {}

static func medal(data: Dictionary, id: String, which: String) -> bool:
	var m = data.logic.medals.get(id)
	return m is Dictionary and bool(m.get(which, false))

## Records a solved attempt. Pure over `data`; the caller saves at once.
## Returns {first_clear, tokens, pushes, steps, best_pushes, best_steps,
## new_best, had_best, fewest, fewest_new, unassisted, unassisted_new, min_pushes}.
static func record_win(data: Dictionary, l: DeliveryLevel, ps: DeliverySession) -> Dictionary:
	var id := l.id
	var pushes := ps.state.pushes
	var steps := ps.state.steps
	var out := {"first_clear": not is_cleared(data, id), "tokens": 0, "pushes": pushes, "steps": steps,
		"min_pushes": l.min_pushes()}
	data.logic.cleared[id] = true
	if Wallet.grant(data, "dl:clear:" + id, l.reward()):
		out.tokens = l.reward()
	var prev := best(data, id)
	out.had_best = not prev.is_empty()
	var better := prev.is_empty() or pushes < int(prev.pushes) \
		or (pushes == int(prev.pushes) and steps < int(prev.steps))
	out.new_best = better and not prev.is_empty()
	if better:
		data.logic.best[id] = {"pushes": pushes, "steps": steps}
	var b := best(data, id)
	out.best_pushes = int(b.pushes)
	out.best_steps = int(b.steps)
	var m: Dictionary = data.logic.medals.get(id, {}) if data.logic.medals.get(id) is Dictionary else {}
	# Fewest pushes only against a proved minimum (never below it: that
	# would mean the level data is wrong, so nothing is awarded).
	out.fewest = l.min_pushes() > 0 and pushes == l.min_pushes()
	out.fewest_new = out.fewest and not bool(m.get("fewest", false))
	out.unassisted = ps.hints_used == 0
	out.unassisted_new = out.unassisted and not bool(m.get("unassisted", false))
	if out.fewest:
		m["fewest"] = true
	if out.unassisted:
		m["unassisted"] = true
	data.logic.medals[id] = m
	if str(data.logic.current.get("id", "")) == id:
		data.logic.current = {}
	return out

# --------------------------------------------------------------- attempt in progress

static func save_attempt(data: Dictionary, ps: DeliverySession) -> void:
	if ps == null or ps.is_won():
		return
	data.logic.current = {"id": ps.level.id, "session": ps.to_dict()}

static func current_id(data: Dictionary) -> String:
	return str(data.logic.current.get("id", ""))

## The saved attempt for `l`, or null. `why` receives "changed" when an
## attempt existed but no longer fits the level (it is then discarded).
static func load_attempt(data: Dictionary, l: DeliveryLevel, why: Array = []) -> DeliverySession:
	var cur: Dictionary = data.logic.current
	if str(cur.get("id", "")) != l.id or not cur.get("session") is Dictionary:
		return null
	var ps := DeliverySession.restore(l, cur.session)
	if ps == null or ps.is_won():
		data.logic.current = {}
		why.append("changed")
		return null
	return ps

static func clear_attempt(data: Dictionary, id: String) -> void:
	if current_id(data) == id:
		data.logic.current = {}
