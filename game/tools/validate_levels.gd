extends SceneTree
## Validates SHIPPED level files and writes docs/LEVEL_REPORT.md.
##   godot --headless --path game -s res://tools/validate_levels.gd            # full report
##   godot --headless --path game -s res://tools/validate_levels.gd -- inspect c017
## Checks: schema, supply == demand, recorded solution replays to a win, an
## independent solver search (budgeted; TIMEOUT => UNVERIFIED), par_counter
## achievable, duplicates, trivial layouts, and (v2) that every mechanic a
## level uses is exercised on its solution line. Exit code 1 on any FAILED level.

const FILES := ["res://data/levels/campaign.json", "res://data/levels/daily.json"]

func _initialize() -> void:
	var args := OS.get_cmdline_user_args()
	if args.size() >= 2 and args[0] == "inspect":
		_inspect(args[1])
		quit(0)
		return
	var rows: Array = []
	var failed := 0
	var unverified := 0
	var sigs := {}
	for path in FILES:
		var doc = JSON.parse_string(FileAccess.get_file_as_string(path))
		for l in doc.levels:
			var errs := LevelValidator.schema_errors(l)
			var verdict := LevelValidator.PASSED
			var def := LevelDef.from_dict(l)
			if errs.is_empty():
				errs = LevelValidator.quantity_errors(def)
			if errs.is_empty():
				var sol: Array = l.meta.get("solution", [])
				if sol.is_empty() or not Solver.verify_path(def, PackedInt32Array(sol)):
					errs.append("recorded solution missing or does not win")
				var eng := LevelValidator.mechanic_engagement(def, PackedInt32Array(sol))
				if def.count_flag(LevelDef.BAG) > 0 and int(eng.reveals) == 0:
					errs.append("bags never revealed on the solution line")
				if def.has_locks() and int(eng.lock_moves) == 0:
					errs.append("lock never matters on the solution line")
				if str(l.id).begins_with("f") and int(eng.fresh_waits) == 0:
					errs.append("fresh items never force a wait")
				var r := Solver.new(300000).solve(PuzzleState.create(def))
				if r.status == Solver.TIMEOUT:
					verdict = LevelValidator.UNVERIFIED
				elif r.status == Solver.UNSOLVABLE:
					errs.append("independent search found no solution")
				var mc := Solver.min_counter_needed(def, 150000)
				if mc < 0:
					verdict = LevelValidator.UNVERIFIED
				elif int(l.meta.get("par_counter", 99)) < mc:
					errs.append("par_counter below achievable minimum")
			var sig := LevelValidator.signature(def)
			if sigs.has(sig):
				errs.append("duplicate of " + sigs[sig])
			sigs[sig] = l.id
			var m: Dictionary = l.meta.get("metrics", {})
			if LevelValidator.is_trivial(m) and not l.meta.has("tutorial"):
				errs.append("trivial layout")
			if not errs.is_empty():
				verdict = LevelValidator.FAILED
				failed += 1
			elif verdict == LevelValidator.UNVERIFIED:
				unverified += 1
			rows.append([l.id, verdict, m, l, errs])
			if not errs.is_empty():
				print("FAILED ", l.id, " ", errs)
	_write_report(rows, failed, unverified)
	print("levels=%d failed=%d unverified=%d" % [rows.size(), failed, unverified])
	quit(1 if failed > 0 else 0)

func _write_report(rows: Array, failed: int, unverified: int) -> void:
	var md := "# Level Report\n\nGenerated by `tools/validate_levels.gd` (Godot %s). " % Engine.get_version_info().string
	md += "Automated solvability does NOT establish fun or fair difficulty; every level below is **awaiting human playtest**.\n\n"
	md += "Totals: %d levels, %d FAILED, %d UNVERIFIED.\n\n" % [rows.size(), failed, unverified]
	md += "Rows are in campaign PLAY ORDER (# = position), then the daily pool.\n\n"
	md += "Columns: crates, items, orders (two-stage), trays, counter capacity, min counter (solver), par (★★ target), random-play win rate (200 seeded playouts; lower = harder), solver nodes, solution length, mechanics (fresh items / bagged items / locked crates).\n\n"
	md += "| # | id | verdict | tier | crates | items | orders (2-stage) | trays | counter | min ctr | par | rand win | nodes | sol len | fresh/bags/locks |\n|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|\n"
	var pos := 0
	for r in rows:
		var m: Dictionary = r[2]
		var l: Dictionary = r[3]
		pos += 1
		md += "| %s | %s | %s | %s | %d | %d | %d (%d) | %d | %d | %d | %d | %.2f | %d | %d | %d/%d/%d |\n" % [str(pos) if str(l.id)[0] != "d" else "", r[0], r[1], l.meta.get("tier", ""),
			int(m.get("crates", 0)), int(m.get("items", 0)), int(m.get("orders", 0)), int(m.get("two_stage", 0)),
			int(l.trays), int(l.counter), int(m.get("min_counter", -1)), int(l.meta.get("par_counter", -1)),
			float(m.get("random_win_rate", 0)), int(m.get("solver_nodes", 0)), l.meta.get("solution", []).size(),
			int(m.get("fresh", 0)), int(m.get("bags", 0)), int(m.get("locked_crates", 0))]
	var docs := ProjectSettings.globalize_path("res://").path_join("../docs").simplify_path()
	DirAccess.make_dir_recursive_absolute(docs)
	var f := FileAccess.open(docs.path_join("LEVEL_REPORT.md"), FileAccess.WRITE)
	f.store_string(md)
	f.close()

## ASCII inspection of one level: crates (front first), orders, solution.
func _inspect(id: String) -> void:
	for path in FILES:
		var doc = JSON.parse_string(FileAccess.get_file_as_string(path))
		for l in doc.levels:
			if l.id != id:
				continue
			print("Level ", id, "  counter=", l.counter, " trays=", l.trays, " tier=", l.meta.get("tier", ""))
			for i in l.crates.size():
				print("  crate %d (front→back): %s" % [i, ", ".join(l.crates[i])])
			for i in l.orders.size():
				print("  order %d: %s" % [i, " THEN ".join(l.orders[i].map(func(s): return JSON.stringify(s)))])
			print("  solution taps: ", l.meta.get("solution", []))
			print("  metrics: ", l.meta.get("metrics", {}))
			return
	print("not found: ", id)
